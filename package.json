{
  "name": "save-the-newts-3d",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npx playwright test --project=chromium --reporter=list",
    "test:unit": "vitest run tests/unit",
    "test:headed": "npx playwright test --project=chromium --headed",
    "start": "npx http-server -p 3000 -c-1",
    "vendor": "node scripts/vendor.mjs",
    "prebuild:web": "npm run vendor",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.44.0",
    "http-server": "^14.1.1",
    "three": "^0.185.1",
    "vitest": "^4.1.10",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
